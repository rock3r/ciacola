{
  "format": 1,
  "id": "ciacola-canonical",
  "title": "Canonical Complete Fixture",
  "stage": { "width": 1600, "height": 900 },
  "themes": {
    "obsidian": {
      "colors": { "accent": "#FF6B5E", "canvas": "#0B0E14", "ink": "#FFFFFF" },
      "typography": {
        "code": { "font": "JetBrains Mono", "size": 24, "weight": 500 },
        "title": { "font": "Inter", "size": 72, "weight": 700, "lineHeight": 84 }
      },
      "motion": { "durationMs": 420, "curve": "standard" }
    },
    "zeta": {
      "colors": { "bg": "#101218", "fg": "#F5F7FA" },
      "typography": {
        "body": { "font": "Inter", "size": 32, "weight": 400 }
      }
    }
  },
  "defaultTheme": "obsidian",
  "fonts": [
    { "family": "JetBrains Mono", "src": "fonts/JetBrainsMono-Regular.ttf", "weight": 400 },
    { "family": "Inter", "src": "fonts/Inter-Regular.ttf", "weight": 400 }
  ],
  "palettes": {
    "cool": { "canvas": "#0D1520", "ink": "#E8F4FF", "accent": "#42B4FF" },
    "warm": { "canvas": "#1A120E", "ink": "#FFF4E8", "accent": "#FF8C42" }
  },
  "loopPeriodsMs": { "alpha/pulse": 1500, "pulse-meter/ambient": 3000 },
  "slides": [
    {
      "id": "s0-cover",
      "title": "Cover",
      "palette": "warm",
      "background": {
        "gradient": {
          "angle": 135,
          "stops": [
            { "at": 0, "color": "#1A120E" },
            { "at": 1, "color": "#2D1E17" }
          ]
        }
      },
      "beats": [
        { "notes": "Opening beat" },
        { "notes": "Second beat", "autoAdvanceMs": 1200 }
      ],
      "nodes": [
        {
          "id": "headline",
          "frame": { "x": 120, "y": 100, "w": 1200, "h": 160 },
          "text": {
            "value": "Hello Ciacola World",
            "style": "title",
            "color": "@ink",
            "surface": { "fill": "#141923", "cornerRadius": 8 },
            "morph": {
              "stagger": {
                "ms": 35,
                "manual": { "Hello#0": 0, "World#0": 180 }
              }
            }
          },
          "builds": [
            {
              "kind": "change",
              "beat": 1,
              "id": "rewrite",
              "set": {
                "opacity": 0.95,
                "rotation": 2.5,
                "text": { "value": "Hello Motion World", "surface": null }
              },
              "durationMs": 500,
              "curve": {
                "bezier": [0.2, 0, 0.2, 1]
              }
            }
          ]
        },
        {
          "id": "rich-sub",
          "frame": { "x": 120, "y": 280, "w": 900, "h": 80 },
          "text": {
            "value": [
              { "text": "Fast ", "weight": 700, "color": "@accent" },
              { "text": "declarative slides", "italic": true }
            ]
          }
        },
        {
          "id": "snippet",
          "frame": { "x": 120, "y": 390, "w": 820, "h": 280 },
          "code": {
            "value": "val x = 1",
            "language": "kotlin",
            "surface": {
              "fill": "#141923",
              "stroke": { "color": "#2C3546", "width": 1.5 },
              "cornerRadius": 16,
              "padding": 20
            }
          },
          "builds": [
            {
              "kind": "change",
              "beat": 1,
              "id": "edit-code",
              "set": {
                "code": { "value": "val x = 42" }
              },
              "durationMs": 40
            }
          ]
        },
        {
          "id": "badge-shape",
          "frame": { "x": 1040, "y": 390, "w": 180, "h": 180 },
          "scale": 1,
          "shape": {
            "geometry": "rect",
            "fill": "@accent",
            "stroke": { "color": "#FFFFFF", "width": 2 },
            "cornerRadius": 24
          },
          "builds": [
            {
              "kind": "enter",
              "beat": 1,
              "id": "pop-in",
              "effect": "pop",
              "args": { "a": 1, "z": 2 },
              "curve": {
                "spring": { "damping": 0.72, "stiffness": 360 }
              }
            },
            {
              "kind": "emphasis",
              "beat": 1,
              "id": "jiggle-it",
              "effect": "jiggle",
              "after": "badge-shape#pop-in",
              "durationMs": 300
            }
          ]
        },
        {
          "id": "photo",
          "frame": { "x": 1260, "y": 390, "w": 320, "h": 200 },
          "image": { "src": "images/hero.png", "fit": "cover" }
        },
        {
          "id": "arrow",
          "connector": {
            "from": "snippet",
            "to": "badge-shape",
            "stroke": { "color": "@accent", "width": 3 },
            "heads": { "end": "filled" }
          }
        },
        {
          "id": "meter",
          "frame": { "x": 1040, "y": 610, "w": 420, "h": 220 },
          "specimen": {
            "ref": "pulse-meter",
            "params": { "bars": 8, "intensity": 0.75, "mode": "wave" },
            "tracks": {
              "sweep": { "beat": 1, "delayMs": 50, "durationMs": 400 }
            }
          }
        },
        {
          "id": "container-stack",
          "frame": { "x": 120, "y": 700, "w": 720, "h": 260 },
          "stack": {
            "children": [
              {
                "id": "inner-row",
                "row": {
                  "children": [
                    {
                      "id": "inner-col",
                      "column": {
                        "children": [
                          {
                            "id": "leaf-note",
                            "text": { "value": "Nested leaf" }
                          }
                        ],
                        "gap": 8
                      }
                    }
                  ],
                  "gap": 16
                }
              }
            ],
            "padding": { "bottom": 8, "left": 12, "right": 12, "top": 8 }
          }
        },
        {
          "id": "zoom-lens",
          "frame": { "x": 1520, "y": 640, "w": 260, "h": 260 },
          "loupe": {
            "children": [
              {
                "id": "lens-target",
                "frame": { "x": 10, "y": 10, "w": 120, "h": 80 },
                "shape": {
                  "geometry": { "path": "M 0 0 L 100 0 L 50 80 Z" }
                }
              }
            ],
            "target": "lens-target"
          }
        }
      ],
      "transition": {
        "type": "magicMove",
        "durationMs": 650,
        "curve": "emphasized",
        "text": {
          "alpha": { "by": "character" },
          "headline": {}
        }
      }
    },
    {
      "id": "s1-end",
      "title": "Fin",
      "palette": "cool",
      "background": {
        "image": { "fit": "cover", "src": "images/bg.png" }
      },
      "beats": [
        { "notes": "Closing" }
      ],
      "nodes": [
        {
          "id": "headline",
          "frame": { "x": 160, "y": 200, "w": 1200, "h": 160 },
          "text": { "value": "Thanks for Watching" },
          "builds": [
            { "kind": "exit", "beat": 0, "effect": "fade", "durationMs": 250 }
          ]
        }
      ]
    }
  ]
}
